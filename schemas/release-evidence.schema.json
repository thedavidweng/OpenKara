{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseEvidence",
  "type": "object",
  "required": ["artifacts", "fragments", "schema_version", "status", "subject"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ArtifactEvidence"
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceFragment"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "status": {
      "$ref": "#/definitions/EvidenceStatus"
    },
    "subject": {
      "$ref": "#/definitions/EvidenceSubject"
    }
  },
  "definitions": {
    "ArtifactEvidence": {
      "type": "object",
      "required": [
        "byte_size",
        "file_name",
        "logical_name",
        "sha256",
        "target"
      ],
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "file_name": {
          "type": "string"
        },
        "logical_name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "updater_signature": {
          "type": ["string", "null"]
        }
      }
    },
    "AssertionEvidence": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "detail": {
          "type": ["string", "null"]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/EvidenceStatus"
        }
      }
    },
    "EvidenceFragment": {
      "type": "object",
      "required": [
        "artifacts",
        "assertions",
        "errors",
        "platform",
        "scenario",
        "schema_version",
        "status",
        "subject"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactEvidence"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssertionEvidence"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platform": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "status": {
          "$ref": "#/definitions/EvidenceStatus"
        },
        "subject": {
          "$ref": "#/definitions/EvidenceSubject"
        }
      }
    },
    "EvidenceStatus": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "EvidenceSubject": {
      "type": "object",
      "required": ["commit_sha", "repository", "tag", "version"],
      "properties": {
        "commit_sha": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
