{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkara.app/schemas/automation-report.schema.json",
  "title": "OpenKara automation report",
  "description": "Canonical schema for machine-verifiable automation reports generated by the OpenKara release gate.",
  "type": "object",
  "required": [
    "scenario",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "application",
    "environment",
    "steps",
    "assertions",
    "artifacts",
    "runtime",
    "model",
    "database",
    "accessibility",
    "audio",
    "errors"
  ],
  "properties": {
    "scenario": {
      "type": "string",
      "description": "Name of the executed automation scenario."
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped"],
      "description": "Overall result of the scenario."
    },
    "started_at": {
      "type": "integer",
      "description": "Scenario start time as a Unix timestamp in milliseconds."
    },
    "finished_at": {
      "type": "integer",
      "description": "Scenario end time as a Unix timestamp in milliseconds."
    },
    "duration_ms": {
      "type": "integer",
      "description": "Wall-clock duration of the scenario in milliseconds.",
      "minimum": 0
    },
    "application": {
      "type": "object",
      "required": ["name", "version", "commit_sha"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit_sha": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "os_version",
        "webview2_version",
        "selected_execution_provider"
      ],
      "properties": {
        "os_version": { "type": "string" },
        "webview2_version": { "type": "string" },
        "selected_execution_provider": { "type": "string" },
        "locale": { "type": "string" },
        "theme": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered list of scenario steps.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "started_at",
          "finished_at",
          "duration_ms"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "started_at": { "type": "integer" },
          "finished_at": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "output": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "description": "Individual assertions recorded during the scenario.",
      "items": {
        "type": "object",
        "required": ["id", "expected", "observed", "result", "artifact_path"],
        "properties": {
          "id": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["pass", "fail"]
          },
          "artifact_path": {
            "type": "string",
            "description": "Path to the artifact associated with this assertion."
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Artifacts retained for the scenario.",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "archive_sha256",
        "extracted_library_sha256",
        "companion_dll_sha256s"
      ],
      "properties": {
        "archive_sha256": { "type": "string" },
        "extracted_library_sha256": { "type": "string" },
        "companion_dll_sha256s": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "archive_sha256",
        "extracted_onnx_sha256",
        "verification_manifest",
        "catalog_generation",
        "release_id",
        "artifact_id",
        "selected_variant"
      ],
      "properties": {
        "archive_sha256": { "type": "string" },
        "extracted_onnx_sha256": { "type": "string" },
        "verification_manifest": { "type": "string" },
        "catalog_generation": { "type": "string" },
        "release_id": { "type": "string" },
        "artifact_id": { "type": "string" },
        "selected_variant": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "required": ["schema_version", "path"],
      "properties": {
        "schema_version": { "type": "integer" },
        "path": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "violations_count",
        "keyboard_trap_count",
        "ui_automation_errors_count"
      ],
      "properties": {
        "violations_count": { "type": "integer", "minimum": 0 },
        "keyboard_trap_count": { "type": "integer", "minimum": 0 },
        "ui_automation_errors_count": { "type": "integer", "minimum": 0 },
        "zoom_levels_tested": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["sample_rate", "channel_count", "non_silent_samples"],
      "properties": {
        "sample_rate": { "type": "integer" },
        "channel_count": { "type": "integer" },
        "input_duration_seconds": { "type": "number" },
        "output_duration_seconds": { "type": "number" },
        "duration_delta_seconds": { "type": "number" },
        "vocals_path": { "type": "string" },
        "accompaniment_path": { "type": "string" },
        "non_silent_samples": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "step_id": { "type": "string" },
          "assertion_id": { "type": "string" }
        }
      }
    }
  }
}
