{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKara",
  "version": "0.12.1",
  "identifier": "com.openkara.desktop",
  "mainBinaryName": "openkara",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/prepare-bundled-oauth-client.mjs && node scripts/clean-macos-bundle.mjs && node scripts/generate-macos-liquid-glass-icon.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenKara",
        "width": 1280,
        "minWidth": 680,
        "height": 800,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' blob: asset: http://asset.localhost; connect-src 'self' https://lrclib.net https://api.lrc.cx; frame-ancestors 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "thedavidweng",
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "generated/oauth": "oauth",
      "icons/Assets.car": "Assets.car"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/thedavidweng/OpenKara/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNkI5OEQzQ0Y0MzEwNEEKUldSS0VFUFAwNWhyZkd1dFV1OEt2eFIvSklDdDJxLzhqdTJsMnYrenBEQWsyQ0dYWXdWT281MUkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
