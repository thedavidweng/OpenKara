{
  "name": "openkara",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm version:sync && vite",
    "build": "pnpm version:sync && tsc && vite build",
    "lint": "node node_modules/oxlint/bin/oxlint --config oxlintrc.json --deny-warnings",
    "icons:generate": "tauri icon src-tauri/icons/app-icon.png && node scripts/generate-macos-liquid-glass-icon.mjs",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "preview": "vite preview",
    "render:flatpak": "node scripts/render-flatpak-manifest.mjs",
    "generate:flatpak-node-sources": "node scripts/generate-flatpak-node-sources.mjs",
    "render:winget": "node scripts/render-winget-manifests.mjs",
    "generate:db-schema": "node scripts/generate-db-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui-smoke": "playwright test",
    "test:ui-smoke:ui": "playwright test --ui",
    "test:e2e": "pnpm test:ui-smoke",
    "test:e2e:ui": "pnpm test:ui-smoke:ui",
    "tauri": "pnpm version:sync && tauri",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "changelog": "git cliff -o CHANGELOG.md",
    "changelog:preview": "git cliff --latest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.21.0",
    "lyric-romanizer": "^0.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sglkc/kuromoji": "1.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260616.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^29.1.1",
    "knip": "^5.61.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "undici": ">=7.28.0 <8.0.0",
      "vitepress>vite": ">=6.4.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "patchedDependencies": {
      "@romanize/korean@0.1.3": "patches/@romanize__korean@0.1.3.patch"
    }
  }
}
