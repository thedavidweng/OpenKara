{
  "name": "openkara",
  "version": "0.9.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm version:sync && vite",
    "build": "pnpm version:sync && tsc && vite build",
    "lint": "node node_modules/oxlint/bin/oxlint --config oxlintrc.json --deny-warnings",
    "icons:generate": "tauri icon src-tauri/icons/app-icon.png && node scripts/generate-macos-liquid-glass-icon.mjs",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "preview": "vite preview",
    "render:flatpak": "node scripts/render-flatpak-manifest.mjs",
    "generate:flatpak-node-sources": "node scripts/generate-flatpak-node-sources.mjs",
    "generate:flatpak-cargo-sources": "node scripts/generate-flatpak-cargo-sources.mjs",
    "render:winget": "node scripts/render-winget-manifests.mjs",
    "generate:db-schema": "node scripts/generate-db-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:patch-coverage": "node scripts/check-patch-coverage.mjs",
    "test:ui-smoke": "playwright test",
    "test:ui-smoke:ui": "playwright test --ui",
    "test:ui-smoke:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:e2e": "pnpm test:ui-smoke",
    "test:e2e:ui": "pnpm test:ui-smoke:ui",
    "tauri": "pnpm version:sync && tauri",
    "docs:dev": "vite --config website/vite.config.ts",
    "docs:build": "vite build --config website/vite.config.ts",
    "docs:preview": "vite preview --config website/vite.config.ts",
    "changelog": "git cliff -o CHANGELOG.md",
    "changelog:preview": "git cliff --latest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "lyric-romanizer": "^0.3.0",
    "pinyin-pro": "3.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.61.1",
    "@sglkc/kuromoji": "1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.7",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.0"
  },
  "packageManager": "pnpm@11.13.0"
}
