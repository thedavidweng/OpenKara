{
  "name": "openkara",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm version:sync && vite",
    "build": "pnpm version:sync && tsc && vite build",
    "lint": "oxlint --config oxlintrc.json --deny-warnings",
    "icons:generate": "tauri icon src-tauri/icons/app-icon.png",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "preview": "vite preview",
    "render:flatpak": "node scripts/render-flatpak-manifest.mjs",
    "render:winget": "node scripts/render-winget-manifests.mjs",
    "generate:db-schema": "node scripts/generate-db-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tauri": "pnpm version:sync && tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^26.0.8",
    "lucide-react": "^1.14.0",
    "lyric-romanizer": "^0.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sglkc/kuromoji": "1.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-virtual": "^3.14.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "patchedDependencies": {
      "@romanize/korean@0.1.3": "patches/@romanize__korean@0.1.3.patch"
    }
  }
}
