{
  "name": "openkara",
  "version": "0.18.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm version:sync && vp dev",
    "build": "pnpm version:sync && tsc && vp build",
    "lint": "vp lint --deny-warnings",
    "icons:generate": "tauri icon src-tauri/icons/app-icon.png && node scripts/generate-macos-liquid-glass-icon.mjs",
    "format": "vp fmt --check",
    "format:write": "vp fmt",
    "preview": "vp preview",
    "render:flatpak": "node scripts/render-flatpak-manifest.mjs",
    "generate:flatpak-node-sources": "node scripts/generate-flatpak-node-sources.mjs",
    "generate:flatpak-cargo-sources": "node scripts/generate-flatpak-cargo-sources.mjs",
    "render:winget": "node scripts/render-winget-manifests.mjs",
    "generate:db-schema": "node scripts/generate-db-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "check:patch-coverage": "node scripts/check-patch-coverage.mjs",
    "test:ui-smoke": "playwright test",
    "test:ui-smoke:ui": "playwright test --ui",
    "test:ui-smoke:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:a11y": "playwright test --project=chromium-accessibility --project=webkit-accessibility",
    "test:a11y:matrix": "node scripts/ci/run-accessibility-matrix.mjs",
    "test:e2e": "pnpm test:ui-smoke",
    "test:e2e:ui": "pnpm test:ui-smoke:ui",
    "test:desktop:windows": "pwsh scripts/ci/run-windows-desktop-e2e.ps1 -InstallDir $env:OPENKARA_WINDOWS_INSTALL_DIR",
    "test:installed:windows": "pwsh scripts/ci/run-windows-desktop-e2e.ps1 -InstallDir $env:OPENKARA_WINDOWS_INSTALL_DIR -Scenario keyboard-workflow",
    "test:bootstrap:faults": "vp test run tests/support/fault-server/fault-server.test.ts",
    "test:remote:fixtures": "vp test run tests/support/remote-provider-fixture/remote-provider-fixture.test.ts",
    "test:automation:schemas": "vp test run tests/automation-report-schema.test.ts",
    "test:release:gate": "pnpm test:automation:schemas && vp test run tests/release-workflow.test.ts",
    "automation:driver:build": "cd src-tauri && cargo build --features automation-driver --bin openkara_automation_driver",
    "automation:driver:run": "cd src-tauri && cargo run --features automation-driver --bin openkara_automation_driver",
    "tauri": "pnpm version:sync && tauri",
    "docs:dev": "vp dev --config website/vite.config.ts",
    "docs:build": "vp build --config website/vite.config.ts",
    "docs:preview": "vp preview --config website/vite.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.61.0",
    "lyric-romanizer": "0.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "30.1.3",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
